import { mkdirSync, readFileSync, writeFileSync } from "node:fs";
import { dirname, resolve } from "node:path";

import {
  AgentRuleError,
  parseAgentFile,
} from "../lib/agent-rules.ts";

const root = resolve(import.meta.dirname, "..");
const source = resolve(root, "instructions/agent.md");
const target = resolve(root, "lib/generated/agent-config.ts");
const relativeSource = "instructions/agent.md";

let markdown: string;

try {
  markdown = readFileSync(source, "utf8");
} catch {
  console.error(`${relativeSource}: file not found`);
  process.exit(1);
}

try {
  const { prompt, rules } = parseAgentFile(markdown);

  mkdirSync(dirname(target), { recursive: true });
  writeFileSync(
    target,
    `// Generated by scripts/generate-agent-config.ts from ${relativeSource}.
// Do not edit by hand. Run: npm run generate:agent

import type { TextRule } from "@/lib/agent-rules";

export const AGENT_PROMPT = ${JSON.stringify(prompt)};

export const TEXT_RULES: TextRule[] = ${JSON.stringify(rules, null, 2)};
`,
    "utf8"
  );

  console.log(
    `agent config: ${rules.length} text rule(s) from ${relativeSource}`
  );
} catch (error) {
  if (error instanceof AgentRuleError) {
    console.error(`${relativeSource}:${error.line}: ${error.message}`);
    process.exit(1);
  }

  throw error;
}
